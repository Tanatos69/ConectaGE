# Supabase — copy to .env.local and fill in from
# Supabase Dashboard → Project Settings → API. Add the same three vars to
# Netlify (Site settings → Environment variables) for deploys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — NEVER prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Comma-separated list of OAuth providers you've actually enabled in
# Supabase (Auth → Providers) with real client id/secret. Leave unset/empty
# to hide all social login buttons — showing one for an unconfigured
# provider fails with "Unsupported provider" when a real user clicks it.
# Example once Google is set up: NEXT_PUBLIC_OAUTH_PROVIDERS=google
NEXT_PUBLIC_OAUTH_PROVIDERS=
