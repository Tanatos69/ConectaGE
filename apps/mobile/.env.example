# Supabase — copy to .env.local and fill in with the same values as
# apps/web/.env.local (same project — the anon key is safe to reuse, it's
# RLS-protected either way). Never put SUPABASE_SERVICE_ROLE_KEY here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Comma-separated list of OAuth providers enabled in Supabase Auth →
# Providers. Leave empty to hide social login buttons.
EXPO_PUBLIC_OAUTH_PROVIDERS=
